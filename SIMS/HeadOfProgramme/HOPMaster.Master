<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="HOPMaster.master.cs"
    Inherits="SIMS.HeadOfProgramme.HOPMaster" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta charset="utf-8" />
    <title>SIMS - Head Of Programme</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <style>
        :root {
            --sidebar-bg: #1e293b;
            --sidebar-hover: #334155;
            --sidebar-width: 240px;
            --body-bg: #f8fafc;
        }

        body {
            margin: 0;
            background: var(--body-bg);
            font-family: 'Segoe UI', sans-serif;
        }

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: var(--sidebar-width);
            height: 100vh;
            background: var(--sidebar-bg);
            color: white;
            display: flex;
            flex-direction: column;
        }

        .sidebar-brand {
            padding: 20px;
            border-bottom: 1px solid #334155;
        }

        .brand-title {
            margin: 0;
            font-size: 22px;
            font-weight: bold;
        }

        .brand-sub {
            color: #94a3b8;
            font-size: 12px;
        }

        .sidebar-user {
            padding: 16px 20px;
            border-bottom: 1px solid #334155;
        }

        .user-name {
            margin: 0;
            font-weight: bold;
            color: white;
        }

        .user-role {
            color: #94a3b8;
            font-size: 12px;
        }

        .sidebar-nav {
            flex: 1;
            padding-top: 15px;
        }

        .nav-label {
            padding: 10px 20px;
            font-size: 11px;
            color: #64748b;
            text-transform: uppercase;
            font-weight: bold;
        }

        .sidebar-nav a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 20px;
            color: #cbd5e1 !important;
            text-decoration: none !important;
            font-size: 14px;
            border-left: 3px solid transparent;
            transition: all 0.15s;
        }

        .sidebar-nav a:hover {
            background: var(--sidebar-hover);
            color: #fff !important;
        }

        .sidebar-nav a.active {
            background: rgba(13,110,253,0.15);
            border-left-color: #0d6efd;
            color: #60a5fa !important;
        }

        .sidebar-nav a i {
            width: 18px;
            text-align: center;
            font-size: 15px;
        }

        .sidebar-footer {
            padding: 20px;
            border-top: 1px solid #334155;
        }

        .btn-logout {
            width: 100%;
            background: #dc2626;
            border: none;
            color: white;
            padding: 10px;
            border-radius: 8px;
            cursor: pointer;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-logout:hover {
            background: #b91c1c;
            color: white;
        }

        .main-wrapper {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
        }

        .topbar {
            background: white;
            border-bottom: 1px solid #e2e8f0;
            padding: 15px 25px;
            display: flex;
            align-items: center;
        }

        .topbar-title {
            margin: 0;
            font-size: 18px;
            font-weight: bold;
            color: #1e293b;
        }

        .topbar-right {
            margin-left: auto;
            color: #64748b;
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .announcement-btn {
            color: #64748b;
            font-size: 18px;
            text-decoration: none;
        }

        .announcement-btn:hover {
            color: #0d6efd;
        }

        .page-content {
            padding: 25px;
        }

        .card-sims {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.08);
            border: 1px solid #e2e8f0;
        }
        
        .card-header-sims {
            padding: 18px 24px;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .card-header-sims h5 {
            font-size: 16px;
            font-weight: bold;
            color: #1e293b;
            margin: 0;
        }
        
        .card-body-sims {
            padding: 24px;
        }
        
        .stat-card {
            background: #fff;
            border-radius: 12px;
            padding: 20px 24px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 1px 4px rgba(0,0,0,0.06);
            display: flex;
            align-items: center;
            gap: 16px;
            height: 100%;
        }
        
        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }
        
        .stat-card .stat-label {
            font-size: 13px;
            color: #64748b;
            margin: 0;
        }
        
        .stat-card .stat-value {
            font-size: 26px;
            font-weight: bold;
            color: #1e293b;
            line-height: 1;
        }

        body.dark-mode {
            --body-bg: #0f172a;
        }
        
        body.dark-mode .topbar,
        body.dark-mode .card-sims,
        body.dark-mode .stat-card {
            background: #1e293b;
            color: #e5e7eb;
            border-color: #334155;
        }
        
        body.dark-mode .topbar-title,
        body.dark-mode .card-header-sims h5,
        body.dark-mode .stat-card .stat-value {
            color: #f8fafc;
        }
        
        body.dark-mode .stat-card .stat-label,
        body.dark-mode .topbar-right,
        body.dark-mode .announcement-btn {
            color: #cbd5e1;
        }
        
        body.dark-mode .page-content {
            color: #e5e7eb;
        }
        
        body.dark-mode table,
        body.dark-mode .table {
            color: #e5e7eb;
        }
        
        body.dark-mode input,
        body.dark-mode select,
        body.dark-mode textarea {
            background: #0f172a !important;
            color: #e5e7eb !important;
            border-color: #475569 !important;
        }


        body.dark-mode,
        body.dark-mode * {
            color: #e5e7eb;
        }
        
        body.dark-mode .text-dark,
        body.dark-mode .text-muted,
        body.dark-mode label,
        body.dark-mode h1,
        body.dark-mode h2,
        body.dark-mode h3,
        body.dark-mode h4,
        body.dark-mode h5,
        body.dark-mode h6,
        body.dark-mode p,
        body.dark-mode span,
        body.dark-mode td,
        body.dark-mode th {
            color: #e5e7eb !important;
        }
        
        body.dark-mode .text-muted,
        body.dark-mode small {
            color: #cbd5e1 !important;
        }
        
        body.dark-mode .card,
        body.dark-mode .modal-content,
        body.dark-mode .dropdown-menu,
        body.dark-mode .list-group-item,
        body.dark-mode .alert {
            background-color: #1e293b !important;
            color: #e5e7eb !important;
            border-color: #334155 !important;
        }

        body.dark-mode .form-control,
        body.dark-mode .form-select,
        body.dark-mode input,
        body.dark-mode select,
        body.dark-mode textarea {
            background-color: #0f172a !important;
            color: #e5e7eb !important;
            border-color: #475569 !important;
        }
        
        body.dark-mode .form-control::placeholder {
            color: #94a3b8 !important;
        }
        
        body.dark-mode .table,
        body.dark-mode table,
        body.dark-mode .gridview {
            background-color: #1e293b !important;
            color: #e5e7eb !important;
        }
        
        body.dark-mode .table th,
        body.dark-mode .table td,
        body.dark-mode table th,
        body.dark-mode table td,
        body.dark-mode .gridview th,
        body.dark-mode .gridview td {
            background-color: #1e293b !important;
            color: #e5e7eb !important;
            border-color: #334155 !important;
        }
        
        body.dark-mode .table thead th,
        body.dark-mode table thead th,
        body.dark-mode .gridview th {
            background-color: #0f172a !important;
            color: #f8fafc !important;
        }
        
        body.dark-mode .table-striped > tbody > tr:nth-of-type(odd) > * {
            background-color: #162033 !important;
            color: #e5e7eb !important;
        }
        
        body.dark-mode .table-hover > tbody > tr:hover > * {
            background-color: #334155 !important;
            color: #ffffff !important;
        }

        /* Stronger dark mode fix for filters, announcements, white panels */
        body.dark-mode div[style*="background:white"],
        body.dark-mode div[style*="background: white"],
        body.dark-mode div[style*="background-color:white"],
        body.dark-mode div[style*="background-color: white"],
        body.dark-mode .filter-card,
        body.dark-mode .filter-box,
        body.dark-mode .filter-panel,
        body.dark-mode .filter-section,
        body.dark-mode .search-card,
        body.dark-mode .search-box,
        body.dark-mode .search-panel,
        body.dark-mode .announcement-card,
        body.dark-mode .announcement-box,
        body.dark-mode .announcement-item,
        body.dark-mode .announcement-section,
        body.dark-mode .bg-light,
        body.dark-mode .bg-white,
        body.dark-mode .border,
        body.dark-mode .rounded,
        body.dark-mode .shadow-sm {
            background-color: #1e293b !important;
            color: #e5e7eb !important;
            border-color: #334155 !important;
        }
        
        /* Inner content inside those boxes */
        body.dark-mode .filter-card *,
        body.dark-mode .filter-box *,
        body.dark-mode .filter-panel *,
        body.dark-mode .filter-section *,
        body.dark-mode .announcement-card *,
        body.dark-mode .announcement-box *,
        body.dark-mode .announcement-item *,
        body.dark-mode .announcement-section * {
            color: #e5e7eb !important;
        }
        
        /* Bootstrap input groups, common in filters */
        body.dark-mode .input-group-text {
            background-color: #334155 !important;
            color: #e5e7eb !important;
            border-color: #475569 !important;
        }
        
        /* Date picker / dropdown style fixes */
        body.dark-mode option {
            background-color: #0f172a !important;
            color: #e5e7eb !important;
        }
        
        /* Fix Bootstrap light buttons inside dark mode */
        body.dark-mode .btn-light,
        body.dark-mode .btn-outline-secondary {
            background-color: #334155 !important;
            color: #e5e7eb !important;
            border-color: #475569 !important;
        }
        
        body.dark-mode .btn-light:hover,
        body.dark-mode .btn-outline-secondary:hover {
            background-color: #475569 !important;
            color: #ffffff !important;
        }

        body.dark-mode .stat-pill,
        body.dark-mode .announcement-card,
        body.dark-mode .form-card,
        body.dark-mode .create-announcement-form {
            background: #1e293b !important;
            color: #e5e7eb !important;
            border: 1px solid #334155 !important;
        }
        
        body.dark-mode .stat-pill *,
        body.dark-mode .announcement-card *,
        body.dark-mode .form-card *,
        body.dark-mode .create-announcement-form * {
            color: #e5e7eb !important;
        }
        
        /* Pending */
        body.dark-mode .status-badge.status-pending {
            background: rgba(245, 158, 11, 0.25) !important;
            color: #fbbf24 !important;
            border: 1px solid #f59e0b !important;
        }
        
        /* Admitted / Approved */
        body.dark-mode .status-badge.status-admitted,
        body.dark-mode .status-badge.status-approved {
            background: rgba(34, 197, 94, 0.25) !important;
            color: #4ade80 !important;
            border: 1px solid #22c55e !important;
        }
        
        /* Rejected */
        body.dark-mode .status-badge.status-rejected {
            background: rgba(239, 68, 68, 0.25) !important;
            color: #f87171 !important;
            border: 1px solid #ef4444 !important;
        }
        
        /* Archived */
        body.dark-mode .status-badge.status-archived {
            background: rgba(100, 116, 139, 0.25) !important;
            color: #cbd5e1 !important;
            border: 1px solid #64748b !important;
        }
        
        /* Generic badge fallback */
        body.dark-mode .status-badge {
            color: inherit !important;
        }
        
        /* Form section backgrounds */
        body.dark-mode .form-group,
        body.dark-mode .filter-group,
        body.dark-mode .filter-container,
        body.dark-mode .announcement-container {
            background: transparent !important;
        }
        /* FINAL DARK MODE OVERRIDE */
        
        body.dark-mode .announcement-card,
        body.dark-mode .announcement-list,
        body.dark-mode .report-card,
        body.dark-mode .task-item,
        body.dark-mode .report-message,
        body.dark-mode .export-panel,
        body.dark-mode .form-card,
        body.dark-mode .create-announcement-form,
        body.dark-mode .stat-pill,
        body.dark-mode .badge-soft {
            background: #1e293b !important;
            background-color: #1e293b !important;
            color: #e5e7eb !important;
            border-color: #334155 !important;
        }
        
        body.dark-mode .announcement-card *,
        body.dark-mode .announcement-list *,
        body.dark-mode .report-card *,
        body.dark-mode .task-item *,
        body.dark-mode .report-message *,
        body.dark-mode .export-panel *,
        body.dark-mode .form-card *,
        body.dark-mode .create-announcement-form *,
        body.dark-mode .stat-pill * {
            color: #e5e7eb !important;
        }

        body.dark-mode .status-badge {
            background: rgba(100, 116, 139, 0.25) !important;
            color: #cbd5e1 !important;
            border: 1px solid #64748b !important;
        }

        /* Dashboard task count links */
        body.dark-mode .task-count,
        body.dark-mode .task-count.text-decoration-none,
        body.dark-mode a.task-count {
            color: #93c5fd !important;
            text-decoration: none !important;
        }
        
        /* Announcement sections */
        body.dark-mode .announcement-header,
        body.dark-mode .announcement-footer {
            background-color: #1e293b !important;
            color: #e5e7eb !important;
            border-color: #334155 !important;
        }
        
        /* Everything inside announcement header/footer */
        body.dark-mode .announcement-header *,
        body.dark-mode .announcement-footer * {
            color: #e5e7eb !important;
        }
        
        /* Links inside announcement areas */
        body.dark-mode .announcement-header a,
        body.dark-mode .announcement-footer a {
            color: #93c5fd !important;
        }
        
        /* Small muted text */
        body.dark-mode .announcement-footer small,
        body.dark-mode .announcement-header small {
            color: #cbd5e1 !important;
        }
    </style>

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>

<body>
<form id="form1" runat="server">

    <div class="sidebar">

        <div class="sidebar-brand">
            <p class="brand-title">SIMS</p>
            <span class="brand-sub">Student Information System</span>
        </div>

        <div class="sidebar-user">
            <p class="user-name">
                <asp:Literal ID="litSidebarName" runat="server" />
            </p>
            <span class="user-role">Head Of Programme</span>
        </div>

        <div class="sidebar-nav">

            <div class="nav-label">Main</div>

            <a href="HOPDashboard.aspx" class='<%= GetActiveClass("HOPDashboard") %>'>
                <i class="fa fa-gauge"></i>
                Dashboard
            </a>

            <div class="nav-label">Management</div>

            <a href="HOPManageProgrammes.aspx" class='<%= GetActiveClass("HOPManageProgrammes") %>'>
                <i class="fa fa-layer-group"></i>
                Manage Programmes
            </a>

            <a href="HOPManageCourses.aspx" class='<%= GetActiveClass("HOPManageCourses") %>'>
                <i class="fa fa-book"></i>
                Manage Courses
            </a>

            <a href="HOPRegisterLecturer.aspx" class='<%= GetActiveClass("HOPRegisterLecturer") %>'>
                <i class="fa fa-user-tie"></i>
                Register Lecturer
            </a>

            <a href="HOPRegisterStudent.aspx" class='<%= GetActiveClass("HOPRegisterStudent") %>'>
                <i class="fa fa-user-graduate"></i>
                Register Student
            </a>

            <a href="HOPAssignUserRole.aspx" class='<%= GetActiveClass("HOPAssignUserRole") %>'>
                <i class="fa fa-users-gear"></i>
                Assign User Roles
            </a>

            <a href="HOPManageAcademicCalendar.aspx" class='<%= GetActiveClass("HOPManageAcademicCalendar") %>'>
                <i class="fa fa-calendar-days"></i>
                Academic Calendar
            </a>
            <a href="HOPManageAdmissions.aspx" class='<%= GetActiveClass("HOPManageAdmissions") %>'>
                <i class="fa fa-clipboard-check"></i>
                Manage Admissions
            </a>


            <a href="HOPManageEnrolments.aspx" class='<%= GetActiveClass("HOPManageEnrolments") %>'>
                <i class="fa fa-user-plus"></i>
                Manage Enrolments
            </a>

            <a href="HOPAuditLogs.aspx" class='<%= GetActiveClass("HOPAuditLogs") %>'>
                <i class="fa fa-clock-rotate-left"></i>
                Audit Logs
            </a>

        </div>

        <div class="sidebar-footer">
            <asp:LinkButton ID="btnSidebarLogout"
                runat="server"
                CssClass="btn-logout"
                OnClick="btnLogout_Click">
                <i class="fa fa-right-from-bracket"></i>
                <span>Logout</span>
            </asp:LinkButton>
        </div>

    </div>

    <div class="main-wrapper">

        <div class="topbar">
            <h5 class="topbar-title">Head Of Programme Portal</h5>

           <div class="topbar-right">

                <button type="button" id="btnDarkMode" class="btn btn-sm btn-outline-secondary">
                    <i class="fa fa-moon"></i>
                </button>
            
                <a href="HOPAnnouncements.aspx" class="announcement-btn" title="Announcements">
                    <i class="fa fa-bell"></i>
                </a>
            
                <span>
                    <asp:Literal ID="litTopbarName" runat="server" />
                </span>
            </div>
        </div>

        <div class="page-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </div>

    </div>

</form>
    <script>
    const btnDarkMode = document.getElementById("btnDarkMode");

    function updateDarkModeButton() {
        if (document.body.classList.contains("dark-mode")) {
            btnDarkMode.innerHTML = '<i class="fa fa-sun"></i>';
        } else {
            btnDarkMode.innerHTML = '<i class="fa fa-moon"></i>';
        }
    }

    if (localStorage.getItem("darkMode") === "enabled") {
        document.body.classList.add("dark-mode");
    }

    updateDarkModeButton();

    btnDarkMode.addEventListener("click", function () {
        document.body.classList.toggle("dark-mode");

        if (document.body.classList.contains("dark-mode")) {
            localStorage.setItem("darkMode", "enabled");
        } else {
            localStorage.setItem("darkMode", "disabled");
        }

        updateDarkModeButton();
    });
</script>
</body>
</html>